{"category":"ByteButtonCustom","color":"#810fd2","uiflow2":{"jscode":"const CUSTOM_BYTEBUTTONCUSTOM_LANGUAGES = {\n  \"CUSTOM_BYTEBUTTONCUSTOM_INIT\": {\n    \"en\": \"%1 init\"\n  },\n  \"CUSTOM_BYTEBUTTONCUSTOM_CREATE\": {\n    \"en\": \"%1 create ByteButton on PAHUB unit variable %2 with I2C Address %3\"\n  },\n  \"CUSTOM_BYTEBUTTONCUSTOM_GET_STATUS\": {\n    \"en\": \"get status of button index %2 from %1\"\n  },\n  \"CUSTOM_BYTEBUTTONCUSTOM_GET_INDICATOR_STATUS\": {\n    \"en\": \"get ByteButton indicator status from %1\"\n  },\n  \"CUSTOM_BYTEBUTTONCUSTOM_SET_COLOR_LEDS\": {\n    \"en\": \"set LED %2 of %1 to color %3\"\n  },\n  \"CUSTOM_BYTEBUTTONCUSTOM_SET_COLOR_INDICATOR\": {\n    \"en\": \"set indicator LED of %1 to color %2\"\n  }\n};\n\nconst initType = 'custom_bytebuttoncustom_init';\nBlockly.BlockRegExpList['custom_bytebuttoncustom'] = {\n  regexp: new RegExp(/^custom_bytebuttoncustom_/),\n  code: \"from ByteButtonCustom import ByteButtonCustom\",\n  initBlockType: initType,\n  categoryId: 'custom_bytebuttoncustom',\n}\nBlockly.utils.registerLanguages(CUSTOM_BYTEBUTTONCUSTOM_LANGUAGES)\n\nBlockly.Msg.CUSTOM_BYTEBUTTONCUSTOM_HUE = '#810fd2'\nBlockly.Msg.CUSTOM_BYTEBUTTONCUSTOM = 'ByteButtonCustom'\n\nBlockly.utils.getcustom_bytebuttoncustomOptions = function() {\n  let options = [];\n  let list = Blockly.utils.getCustomNameList(initType);\n  for (let i = 0; i < list.length; i++) {\n    let value = list[i];\n    options.push([String(value), String(value)]);\n  }\n  if (options.length === 0) return [\n    ['bytebuttoncustom_0', 'bytebuttoncustom_0']\n  ];\n  return options;\n}\n\n\nBlockly.Blocks[\"custom_bytebuttoncustom_init\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_BYTEBUTTONCUSTOM_INIT,\n      'args0': [\n        // { 'type': 'field_dropdown', 'name': 'NAME', 'options': Blockly.utils.getcustom_bytebuttoncustomOptions },\n        {\n          'type': 'field_input',\n          'name': 'NAME',\n          'text': 'bytebuttoncustom_0'\n        },\n\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#810fd2\",\n      \"tool\": []\n    };\n  }\n}\n\nBlockly.Python[\"custom_bytebuttoncustom_init\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return `${varname} = ByteButtonCustom()\\n`\n}\n\nBlockly.Blocks[\"custom_bytebuttoncustom_create\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_BYTEBUTTONCUSTOM_CREATE,\n      'args0': [{\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_bytebuttoncustomOptions\n        },\n        {\n          'type': 'input_value',\n          'name': 'pahub_unit'\n        }, {\n          'type': 'input_value',\n          'name': 'i2c_address'\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#810fd2\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_bytebuttoncustom_create\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var pahub_unit = Blockly.Python.valueToCode(block, 'pahub_unit', Blockly.Python.ORDER_FUNCTION_CALL);\n  var i2c_address = Blockly.Python.valueToCode(block, 'i2c_address', Blockly.Python.ORDER_FUNCTION_CALL);\n  return [`${varname}.create(${pahub_unit}, ${i2c_address})`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_bytebuttoncustom_get_status\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_BYTEBUTTONCUSTOM_GET_STATUS,\n      'args0': [{\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_bytebuttoncustomOptions\n        },\n        {\n          'type': 'input_value',\n          'name': 'button_index'\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#810fd2\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_bytebuttoncustom_get_status\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var button_index = Blockly.Python.valueToCode(block, 'button_index', Blockly.Python.ORDER_FUNCTION_CALL);\n  return [`${varname}.get_status(${button_index})`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_bytebuttoncustom_get_indicator_status\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_BYTEBUTTONCUSTOM_GET_INDICATOR_STATUS,\n      'args0': [{\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_bytebuttoncustomOptions\n        },\n\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#810fd2\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_bytebuttoncustom_get_indicator_status\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.get_indicator_status()`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_bytebuttoncustom_set_color_leds\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_BYTEBUTTONCUSTOM_SET_COLOR_LEDS,\n      'args0': [{\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_bytebuttoncustomOptions\n        },\n        {\n          'type': 'input_value',\n          'name': 'index'\n        }, {\n          'type': 'input_value',\n          'name': 'color'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#810fd2\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_bytebuttoncustom_set_color_leds\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var index = Blockly.Python.valueToCode(block, 'index', Blockly.Python.ORDER_FUNCTION_CALL);\n  var color = Blockly.Python.valueToCode(block, 'color', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname}.set_color_LEDs(${index}, ${color})\\n`\n}\n\nBlockly.Blocks[\"custom_bytebuttoncustom_set_color_indicator\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_BYTEBUTTONCUSTOM_SET_COLOR_INDICATOR,\n      'args0': [{\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_bytebuttoncustomOptions\n        },\n        {\n          'type': 'input_value',\n          'name': 'color'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#810fd2\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_bytebuttoncustom_set_color_indicator\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var color = Blockly.Python.valueToCode(block, 'color', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname}.set_color_indicator(${color})\\n`\n}","toolbox":"\n<category name=\"ByteButtonCustom\" colour=\"#810fd2\" hidden=\"true\" toolboxitemid=\"custom_bytebuttoncustom\">\n<title text=\"ByteButtonCustom\" docsLink=\"https://github.com/neusmstack\"></title>\n<block type=\"custom_bytebuttoncustom_init\"/><block type=\"custom_bytebuttoncustom_create\">\n  <value name=\"pahub_unit\">\n    <shadow type=\"text\">\n      <field name=\"TEXT\"/>\n    </shadow>\n  </value>\n  <value name=\"i2c_address\">\n    <shadow type=\"text\">\n      <field name=\"TEXT\"/>\n    </shadow>\n  </value>\n</block><block type=\"custom_bytebuttoncustom_get_status\">\n  <value name=\"button_index\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_bytebuttoncustom_get_indicator_status\"/><block type=\"custom_bytebuttoncustom_set_color_leds\">\n  <value name=\"index\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n  <value name=\"color\">\n    <shadow type=\"text\">\n      <field name=\"TEXT\">0x000000</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_bytebuttoncustom_set_color_indicator\">\n  <value name=\"color\">\n    <shadow type=\"text\">\n      <field name=\"TEXT\">0x000000</field>\n    </shadow>\n  </value>\n</block>\n</category>\n","toolboxitemid":"custom_bytebuttoncustom","block_type":["custom_bytebuttoncustom___init__","custom_bytebuttoncustom_create","custom_bytebuttoncustom_get_status","custom_bytebuttoncustom_get_indicator_status","custom_bytebuttoncustom_set_color_leds","custom_bytebuttoncustom_set_color_indicator"]},"data":{"name":"ByteButtonCustom","note":{"en":"Custom ByteButton Unit for PAHUB"},"details":{"color":"#810fd2","link":"https://github.com/neusmstack","image":"","category":"Custom"},"header":{"file":"ByteButtonCustom","time":"2025-06-29","author":"Neus Morlà Arias","email":"neusmstack@gmail.com","license":"MIT License"},"assignments":[],"example":"","source_internal":"","source_external":"","members":[{"name":"__init__","note":{},"label":{"en":"%1 init"},"params":[],"return":"","source":"        pass","ast_return":{"code":null,"id":null},"doc_return":null},{"name":"create","note":{},"label":{"en":"%1 create ByteButton on PAHUB unit variable %2 with I2C Address %3"},"params":[{"name":"pahub_unit","type":"str","default":"","note":{},"field":""},{"name":"i2c_address","type":"str","default":"","note":{},"field":""}],"return":"","source":"        pass","ast_return":{"code":null,"id":"None"},"doc_return":null},{"name":"get_status","note":{},"label":{"en":"get status of button index %2 from %1"},"params":[{"name":"button_index","type":"int","default":"0","note":{},"field":"number","max":"7","min":"0"}],"return":"","source":"        pass","ast_return":{"code":null,"id":"int"},"doc_return":{"type":"int"}},{"name":"get_indicator_status","note":{},"label":{"en":"get ByteButton indicator status from %1"},"params":[],"return":"","source":"        pass","ast_return":{"code":null,"id":"bool"},"doc_return":{"type":"bool"}},{"name":"set_color_LEDs","note":{},"label":{"en":"set LED %2 of %1 to color %3"},"params":[{"name":"index","type":"int","default":"0","note":{},"field":"number","max":"7","min":"0"},{"name":"color","type":"str","default":"0x000000","note":{},"field":""}],"return":"","source":"        pass","ast_return":{"code":null,"id":null},"doc_return":null},{"name":"set_color_indicator","note":{},"label":{"en":"set indicator LED of %1 to color %2"},"params":[{"name":"color","type":"str","default":"0x000000","note":{},"field":""}],"return":"","source":"        pass","ast_return":{"code":null,"id":null},"doc_return":null}],"python_file_name":"bytebuttoncustom"},"pyCode":"\n\"\"\"\nfile     ByteButtonCustom\ntime     2025-06-29\nauthor   Neus Morlà Arias\nemail   neusmstack@gmail.com\nlicense  MIT License\n\"\"\"\n\n\n\nclass ByteButtonCustom:\n    \"\"\"\n    note:\n        en: Custom ByteButton Unit for PAHUB\n    details:\n        color: '#810fd2'\n        link: https://github.com/neusmstack\n        image: ''\n        category: Custom\n    example: ''\n    \"\"\"\n\n\n\n\n    def __init__(self):\n        \"\"\"\n        label:\n            en: '%1 init'\n        \"\"\"\n        pass\n\n    def create(self, pahub_unit: str, i2c_address: str) -> None:\n        \"\"\"\n        label:\n            en: '%1 create ByteButton on PAHUB unit variable %2 with I2C Address %3'\n        params:\n            pahub_unit:\n                name: pahub_unit\n                type: str\n            i2c_address:\n                name: i2c_address\n                type: str\n        \"\"\"\n        pass\n\n    def get_status(self, button_index: int = 0) -> int:\n        \"\"\"\n        label:\n            en: get status of button index %2 from %1\n        params:\n            button_index:\n                name: button_index\n                type: int\n                default: '0'\n                field: number\n                max: '7'\n                min: '0'\n        return:\n            type: int\n        \"\"\"\n        pass\n\n    def get_indicator_status(self) -> bool:\n        \"\"\"\n        label:\n            en: get ByteButton indicator status from %1\n        return:\n            type: bool\n        \"\"\"\n        pass\n\n    def set_color_LEDs(self, index: int = 0, color: str = '0x000000'):\n        \"\"\"\n        label:\n            en: set LED %2 of %1 to color %3\n        params:\n            index:\n                name: index\n                type: int\n                default: '0'\n                field: number\n                max: '7'\n                min: '0'\n            color:\n                name: color\n                type: str\n                default: '0x000000'\n        \"\"\"\n        pass\n\n    def set_color_indicator(self, color: str = '0x000000'):\n        \"\"\"\n        label:\n            en: set indicator LED of %1 to color %2\n        params:\n            color:\n                name: color\n                type: str\n                default: '0x000000'\n        \"\"\"\n        pass\n\n\n","version":"alpha2"}