{"category":"PAHUBUnit","color":"#ff8800","uiflow2":{"jscode":"const CUSTOM_PAHUBUNIT_LANGUAGES = {\n  \"CUSTOM_PAHUBUNIT_INIT\": {\n    \"en\": \"%1 init\"\n  },\n  \"CUSTOM_PAHUBUNIT_CREATE\": {\n    \"en\": \"create %1 i2c Channel  %2\"\n  }\n};\n\nconst initType = 'custom_pahubunit_init';\nBlockly.BlockRegExpList['custom_pahubunit'] = {\n  regexp: new RegExp(/^custom_pahubunit_/),\n  code: \"from PAHUBUnit import PAHUBUnit\",\n  initBlockType: initType,\n  categoryId: 'custom_pahubunit',\n}\nBlockly.utils.registerLanguages(CUSTOM_PAHUBUNIT_LANGUAGES)\n\nBlockly.Msg.CUSTOM_PAHUBUNIT_HUE = '#ff8800'\nBlockly.Msg.CUSTOM_PAHUBUNIT = 'PAHUBUnit'\n\nBlockly.utils.getcustom_pahubunitOptions = function() {\n  let options = [];\n  let list = Blockly.utils.getCustomNameList(initType);\n  for (let i = 0; i < list.length; i++) {\n    let value = list[i];\n    options.push([String(value), String(value)]);\n  }\n  if (options.length === 0) return [\n    ['pahubunit_0', 'pahubunit_0']\n  ];\n  return options;\n}\n\n\nBlockly.Blocks[\"custom_pahubunit_init\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_PAHUBUNIT_INIT,\n      'args0': [\n        // { 'type': 'field_dropdown', 'name': 'NAME', 'options': Blockly.utils.getcustom_pahubunitOptions },\n        {\n          'type': 'field_input',\n          'name': 'NAME',\n          'text': 'pahubunit_0'\n        },\n\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#ff8800\",\n      \"tool\": []\n    };\n  }\n}\n\nBlockly.Python[\"custom_pahubunit_init\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return `${varname} = PAHUBUnit()\\n`\n}\n\nBlockly.Blocks[\"custom_pahubunit_create\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_PAHUBUNIT_CREATE,\n      'args0': [{\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_pahubunitOptions\n        },\n        {\n          'type': 'input_value',\n          'name': 'channel'\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#ff8800\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_pahubunit_create\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var channel = Blockly.Python.valueToCode(block, 'channel', Blockly.Python.ORDER_FUNCTION_CALL);\n  return [`${varname}.create(${channel})`, Blockly.Python.ORDER_NONE]\n}","toolbox":"\n<category name=\"PAHUBUnit\" colour=\"#ff8800\" hidden=\"true\" toolboxitemid=\"custom_pahubunit\">\n<title text=\"PAHUBUnit\" docsLink=\"https://github.com/neusmstack\"></title>\n<block type=\"custom_pahubunit_init\"/><block type=\"custom_pahubunit_create\">\n  <value name=\"channel\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n</block>\n</category>\n","toolboxitemid":"custom_pahubunit","block_type":["custom_pahubunit___init__","custom_pahubunit_create"]},"data":{"name":"PAHUBUnit","note":{"en":"PAHUB Unit for I2C Multiplexer control"},"details":{"color":"#ff8800","link":"https://github.com/neusmstack","image":"","category":"Custom"},"header":{"file":"PAHUBUnit","time":"2025-06-29","author":"Neus Morlà Arias","email":"neusmstack@gmail.com","license":"MIT License"},"assignments":[],"example":"","source_internal":"","source_external":"","members":[{"name":"__init__","note":{},"label":{"en":"%1 init"},"params":[],"return":"","source":"        pass","ast_return":{"code":null,"id":null},"doc_return":null},{"name":"create","note":{},"label":{"en":"create %1 i2c Channel  %2"},"params":[{"name":"channel","type":"int","default":"0","note":{},"field":"number","max":"100","min":"0"}],"return":"","source":"        pass","ast_return":{"code":null,"id":"None"},"doc_return":null}],"python_file_name":"pahubunit"},"pyCode":"\n\"\"\"\nfile     PAHUBUnit\ntime     2025-06-29\nauthor   Neus Morlà Arias\nemail   neusmstack@gmail.com\nlicense  MIT License\n\"\"\"\n\n\n\nclass PAHUBUnit:\n    \"\"\"\n    note:\n        en: PAHUB Unit for I2C Multiplexer control\n    details:\n        color: '#ff8800'\n        link: https://github.com/neusmstack\n        image: ''\n        category: Custom\n    example: ''\n    \"\"\"\n\n\n\n\n    def __init__(self):\n        \"\"\"\n        label:\n            en: '%1 init'\n        \"\"\"\n        pass\n\n    def create(self, channel: int = 0) -> None:\n        \"\"\"\n        label:\n            en: create %1 i2c Channel  %2\n        params:\n            channel:\n                name: channel\n                type: int\n                default: '0'\n                field: number\n                max: '100'\n                min: '0'\n        \"\"\"\n        pass\n\n\n","version":"alpha2"}