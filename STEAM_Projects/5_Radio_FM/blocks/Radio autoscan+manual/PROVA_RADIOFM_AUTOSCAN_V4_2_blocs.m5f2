nity\" min=\"-Infinity\" precision=\"0\"></mutation><field name=\"NUM\">1</field></block></value></block></value><value name=\"VALUE2\"><shadow type=\"math_number\" id=\"W=(Q^Q|!O/Oq?#71s(R.\" disabled=\"true\"><mutation max=\"Infinity\" min=\"-Infinity\" precision=\"0\"></mutation><field name=\"NUM\">1</field></shadow><block type=\"math_number\" id=\"TsMBnM{u_+4zU-@JxQop\"><mutation max=\"Infinity\" min=\"-Infinity\" precision=\"0\"></mutation><field name=\"NUM\">128</field></block></value></block></value><value name=\"B\"><block type=\"math_number\" id=\"ItP=M.!.5P6dxw^_3udP\"><mutation max=\"Infinity\" min=\"-Infinity\" precision=\"0\"></mutation><field name=\"NUM\">0</field></block></value></block></value><statement name=\"DO0\"><block type=\"math_change\" id=\"oZtdZe`sGDCDn.+zE)/z\"><field name=\"VAR\" id=\"ix)jD_4NlgCp8Bb$,d-c\">count</field><value name=\"DELTA\"><shadow type=\"math_number\" id=\"HK^;?A]U1B0+aglR;^SJ\"><mutation max=\"Infinity\" min=\"-Infinity\" precision=\"0\"></mutation><field name=\"NUM\">1</field></shadow><block type=\"math_number\" id=\")W_}J^F0QwtkX.i{-wyV\"><mutation max=\"Infinity\" min=\"-Infinity\" precision=\"0\"></mutation><field name=\"NUM\">1</field></block></value><next><block type=\"time_sleep_millisecond\" id=\"HZ_V!LseDd8fjGdVoA@P\"><value name=\"MS\"><shadow type=\"math_number\" id=\"uk$oLz?D!n.bT`B:tCbq\"><mutation max=\"Infinity\" min=\"0\" precision=\"0\"></mutation><field name=\"NUM\">100</field></shadow></value></block></next></block></statement></block></next></block></next></block></next></block></statement><next><block type=\"controls_if\" id=\"ai^2ZO(=X#fSj)7YhXpL\"><value name=\"IF0\"><block type=\"logic_compare\" id=\":qWPdUUj!8VW8BsViGeu\"><field name=\"OP\">GTE</field><value name=\"A\"><block type=\"variables_get\" id=\"3l2+:BQ]{2c(Y0FMn)6(\"><field name=\"VAR\" id=\"ix)jD_4NlgCp8Bb$,d-c\">count</field></block></value><value name=\"B\"><block type=\"math_number\" id=\"c^kz5Qt@XjqL?730Qgoa\"><mutation max=\"Infinity\" min=\"-Infinity\" precision=\"0\"></mutation><field name=\"NUM\">2</field></block></value></block></value><statement name=\"DO0\"><block type=\"variables_set\" id=\"e{bK4;;KsD#u+GK9nsM.\"><field name=\"VAR\" id=\"$p`RfkyX#PLf7.,;`UC6\">emissora_detectada</field><value name=\"VALUE\"><block type=\"logic_boolean\" id=\"Q{vFejJDtG_8a,PPYHWA\"><field name=\"BOOL\">TRUE</field></block></value></block></statement></block></next></block></next></block></next></block></statement></block>","screen":[{"simulationName":"Built-in","type":"builtin","width":320,"height":240,"scale":0.77,"screenName":"","blockId":"","screenColorType":0,"rotation":1,"id":"builtin","createTime":1750692430497}],"logicWhenNum":0,"customList":[{"id":"custom_fmradiomem","name":"FMRadioMem","color":"#0fb1d2","blockly":"const CUSTOM_FMRADIOMEM_LANGUAGES = {\n  \"CUSTOM_FMRADIOMEM_INIT\": {\n    \"en\": \"Initialize FMRadioMem %1 init\"\n  },\n  \"CUSTOM_FMRADIOMEM_SAVE_STATIONS\": {\n    \"en\": \"Save stations to flash %1 save_stations\"\n  },\n  \"CUSTOM_FMRADIOMEM_LOAD_STATIONS\": {\n    \"en\": \"Load stations from flash %1 load_stations\"\n  }\n};\n\nconst initType = 'custom_fmradiomem_init';\nBlockly.BlockRegExpList['custom_fmradiomem'] = {\n  regexp: new RegExp(/^custom_fmradiomem_/),\n  code: \"from FMRadioMem import FMRadioMem\",\n  initBlockType: initType,\n  categoryId: 'custom_fmradiomem',\n}\nBlockly.utils.registerLanguages(CUSTOM_FMRADIOMEM_LANGUAGES)\n\nBlockly.Msg.CUSTOM_FMRADIOMEM_HUE = '#0fb1d2'\nBlockly.Msg.CUSTOM_FMRADIOMEM = 'FMRadioMem'\n\nBlockly.utils.getcustom_fmradiomemOptions = function() {\n  let options = [];\n  let list = Blockly.utils.getCustomNameList(initType);\n  for (let i = 0; i < list.length; i++) {\n    let value = list[i];\n    options.push([String(value), String(value)]);\n  }\n  if (options.length === 0) return [\n    ['fmradiomem_0', 'fmradiomem_0']\n  ];\n  return options;\n}\n\n\nBlockly.Blocks[\"custom_fmradiomem_init\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_FMRADIOMEM_INIT,\n      'args0': [\n        // { 'type': 'field_dropdown', 'name': 'NAME', 'options': Blockly.utils.getcustom_fmradiomemOptions },\n        {\n          'type': 'field_input',\n          'name': 'NAME',\n          'text': 'fmradiomem_0'\n        },\n\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#0fb1d2\",\n      \"tool\": []\n    };\n  }\n}\n\nBlockly.Python[\"custom_fmradiomem_init\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return `${varname} = FMRadioMem()\\n`\n}\n\nBlockly.Blocks[\"custom_fmradiomem_save_stations\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_FMRADIOMEM_SAVE_STATIONS,\n      'args0': [{\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_fmradiomemOptions\n        },\n\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#0fb1d2\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_fmradiomem_save_stations\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return `${varname}.save_stations()\\n`\n}\n\nBlockly.Blocks[\"custom_fmradiomem_load_stations\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_FMRADIOMEM_LOAD_STATIONS,\n      'args0': [{\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_fmradiomemOptions\n        },\n\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#0fb1d2\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_fmradiomem_load_stations\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return `${varname}.load_stations()\\n`\n}","toolbox":"\n<category name=\"FMRadioMem\" colour=\"#0fb1d2\" hidden=\"true\" toolboxitemid=\"custom_fmradiomem\">\n<title text=\"FMRadioMem\" docsLink=\"https://github.com/neusmstack\"></title>\n<block type=\"custom_fmradiomem_init\"/><block type=\"custom_fmradiomem_save_stations\"/><block type=\"custom_fmradiomem_load_stations\"/>\n</category>\n","pyCode":"\n\"\"\"\nfile     FMRadioMem\ntime     2025-07-02\nauthor   Neus Morlà Arias\nemail   neusmstack@gmail.com\nlicense  \n\"\"\"\n\n\n\nclass FMRadioMem:\n    \"\"\"\n    note:\n        en: ''\n    details:\n        color: '#0fb1d2'\n        link: https://github.com/neusmstack\n        image: ''\n        category: Custom\n    example: ''\n    \"\"\"\n\n\n\n\n    def __init__(self):\n        \"\"\"\n        label:\n            en: Initialize FMRadioMem %1 init\n        \"\"\"\n        pass\n\n    def save_stations(self):\n        \"\"\"\n        label:\n            en: Save stations to flash %1 save_stations\n        \"\"\"\n        try:\n            global emissores_guardades\n            with open('/flash/stations.txt', 'w') as f:\n                for freq in emissores_guardades:\n                    f.write(str(freq) + '\\n')\n            print('Stations saved successfully.')\n        except Exception as e:\n            print('Error saving stations:', e)\n\n    def load_stations(self):\n        \"\"\"\n        label:\n            en: Load stations from flash %1 load_stations\n        \"\"\"\n        try:\n            global emissores_guardades\n            with open('/flash/stations.txt', 'r') as f:\n                lines = f.readlines()\n                for i in range(min(10, len(lines))):\n                    emissores_guardades[i] = int(lines[i].strip())\n            print('Stations loaded successfully.')\n        except Exception as e:\n            print('Error loading stations:', e)\n\n\n"}]}